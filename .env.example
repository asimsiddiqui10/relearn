# --- infrastructure (docker-compose defaults; override if ports clash) ---
POSTGRES_USER=relearn
POSTGRES_PASSWORD=relearn
POSTGRES_DB=relearn
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://relearn:relearn@localhost:5432/relearn

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# durable host-filesystem mirror of raw PDFs + Marker parse JSON + images.
# absolute path; written alongside S3 and read as a fallback so re-ingestion
# never re-pays Datalab. leave empty to disable.
LOCAL_CACHE_DIR=

# S3-compatible object storage (MinIO in dev, AWS S3 in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=relearn
S3_ACCESS_KEY=relearn
S3_SECRET_KEY=relearn-dev
MINIO_ROOT_USER=relearn
MINIO_ROOT_PASSWORD=relearn-dev

# --- services ---
BACKEND_PORT=8000
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://localhost:8001
# shared secret between backend and AI service (internal token)
INTERNAL_TOKEN=dev-internal-token

# --- auth ---
# dev: backend issues local HS256 JWTs; prod: set AUTH_MODE=oidc + Cognito issuer
AUTH_MODE=dev
AUTH_DEV_SECRET=dev-jwt-secret-change-me
# AUTH_MODE=oidc
# OIDC_ISSUER=https://cognito-idp.<region>.amazonaws.com/<pool-id>
# OIDC_AUDIENCE=<app-client-id>

# --- parsing & models ---
DATALAB_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- observability (no-op when empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=
